# ===================================================
# BuildForge AI - Environment Configuration
# ===================================================

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="BuildForge AI"

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/buildforge?schema=public"
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/buildforge_shadow?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth (NextAuth v5)
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# AI Providers
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""

# Default AI provider: openai | anthropic | google | mock
DEFAULT_AI_PROVIDER="mock"
DEFAULT_AI_MODEL="gpt-4o"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_AGENCY=""

# Storage (S3)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="buildforge-uploads"
STORAGE_PROVIDER="local"

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="BuildForge AI <noreply@buildforge.ai>"

# Vector DB
PINECONE_API_KEY=""
PINECONE_INDEX="buildforge"
PINECONE_ENVIRONMENT="us-east-1"

# Monitoring
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# App Limits
FREE_PLAN_PROJECTS=2
FREE_PLAN_AGENT_RUNS=5
